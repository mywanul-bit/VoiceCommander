<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Floating bubble: "Display over other apps" (special permission,
         granted only in Settings — declaring it does not grant it) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Contacts lookup for "মেসেজ দাও / কল করো" -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Close a foreground app -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Listening runs as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Foreground-service notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dial a contact by voice -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Torch / flashlight -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Bluetooth on/off (BLUETOOTH_CONNECT is the runtime permission on Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- WiFi state (panel/settings fallbacks; direct toggle is blocked on Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Alarm: exact alarms when permitted, system clock fallback otherwise -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Brightness: special permission, granted from Settings -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Speech recognition / TTS service visibility (targetSdk 30+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceCommander"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VoiceCommandService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Floating bubble over other apps (overlay + mic trigger) -->
        <service
            android:name=".FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".CommanderAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Alarm: rings at the requested time, shows a dismiss notification -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".AlarmDismissReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mywanul.voicecommander.DISMISS_ALARM" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
